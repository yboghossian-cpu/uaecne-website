# /etc/caddy/Caddyfile — HTTPS certificates are automatic (Let's Encrypt).
uaecne.org {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
	reverse_proxy 127.0.0.1:3000
}

www.uaecne.org {
	redir https://uaecne.org{uri} permanent
}
