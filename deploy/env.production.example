# Copy to /var/www/uaecne/.env.production on the server (chmod 600).
# Never commit the real file.

# Public address of the site (used for links, sitemap, secure cookies)
SITE_URL=https://uaecne.org

# Where the database and uploaded photos are kept (backed up nightly)
UAECNE_DATA_DIR=/var/lib/uaecne

# Keeps admin pages working across redeploys. Generate once with:
#   openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Gmail account that sends form notifications, and its 16-character
# Google "app password" (Google Account › Security › App passwords).
SMTP_USER=
SMTP_PASS=
